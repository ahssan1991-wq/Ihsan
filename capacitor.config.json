{
  "appId": "com.emis.inspection",
  "appName": "EMIS Inspection System",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "backgroundColor": "#0b0f19"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0b0f19",
      "showSpinner": false
    }
  }
}

